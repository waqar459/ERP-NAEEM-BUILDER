# Port for production web server (Hostinger provides this dynamically or uses 3000)
PORT=3000

# Node environment mode
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI API calls. Never commit real keys.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this ERP is hosted (e.g., https://naeembuilder.byteimpact.com)
APP_URL="https://naeembuilder.byteimpact.com"
